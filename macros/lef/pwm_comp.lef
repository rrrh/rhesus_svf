VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO pwm_comp
  CLASS BLOCK ;
  FOREIGN pwm_comp ;
  ORIGIN 0.000 0.000 ;
  SIZE 40.000 BY 15.000 ;

  PIN vdd
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 13.000 40.000 15.000 ;
    END
  END vdd

  PIN vss
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 0.000 40.000 2.000 ;
    END
  END vss

  PIN vinp
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER Metal2 ;
        RECT 0.000 4.500 0.500 5.500 ;
    END
  END vinp

  PIN vinn
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER Metal2 ;
        RECT 0.000 8.500 0.500 9.500 ;
    END
  END vinn

  PIN out
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER Metal2 ;
        RECT 39.500 6.500 40.000 7.500 ;
    END
  END out

  OBS
    LAYER Metal1 ; RECT 0.000 0.000 40.000 15.000 ;
    LAYER Metal2 ; RECT 0.000 0.000 40.000 15.000 ;
    LAYER Metal3 ; RECT 0.000 0.000 40.000 15.000 ;
  END
END pwm_comp
END LIBRARY
