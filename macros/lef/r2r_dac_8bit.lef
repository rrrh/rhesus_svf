VERSION 5.7 ;
NOWIREEXTENSIONATPIN ON ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
MACRO r2r_dac_8bit
  CLASS BLOCK ;
  FOREIGN r2r_dac_8bit ;
  ORIGIN 0.000 0.000 ;
  SIZE 54.000 BY 60.000 ;
  OBS
    LAYER Metal1 ; RECT 0.000 0.000 54.000 60.000 ;
    LAYER Metal2 ; RECT 1.500 3.000 52.500 57.000 ;
    LAYER Metal3 ; RECT 1.500 3.000 52.500 57.000 ;
  END
  PIN vdd
    DIRECTION INOUT ; USE POWER ; PORT LAYER Metal3 ; RECT 0.000 58.500 54.000 60.000 ; END
  END vdd
  PIN vss
    DIRECTION INOUT ; USE GROUND ; PORT LAYER Metal3 ; RECT 0.000 0.000 54.000 1.500 ; END
  END vss
  PIN vout
    DIRECTION OUTPUT ; USE SIGNAL ; PORT LAYER Metal2 ; RECT 53.500 14.500 54.000 15.500 ; END
  END vout
  PIN d0
    DIRECTION INPUT ; USE SIGNAL ; PORT LAYER Metal2 ; RECT 0.000 1.900 0.500 2.300 ; END
  END d0
  PIN d1
    DIRECTION INPUT ; USE SIGNAL ; PORT LAYER Metal2 ; RECT 0.000 2.740 0.500 3.140 ; END
  END d1
  PIN d2
    DIRECTION INPUT ; USE SIGNAL ; PORT LAYER Metal2 ; RECT 0.000 3.580 0.500 3.980 ; END
  END d2
  PIN d3
    DIRECTION INPUT ; USE SIGNAL ; PORT LAYER Metal2 ; RECT 0.000 4.420 0.500 4.820 ; END
  END d3
  PIN d4
    DIRECTION INPUT ; USE SIGNAL ; PORT LAYER Metal2 ; RECT 0.000 5.260 0.500 5.660 ; END
  END d4
  PIN d5
    DIRECTION INPUT ; USE SIGNAL ; PORT LAYER Metal2 ; RECT 0.000 6.100 0.500 6.500 ; END
  END d5
  PIN d6
    DIRECTION INPUT ; USE SIGNAL ; PORT LAYER Metal2 ; RECT 0.000 6.940 0.500 7.340 ; END
  END d6
  PIN d7
    DIRECTION INPUT ; USE SIGNAL ; PORT LAYER Metal2 ; RECT 0.000 7.780 0.500 8.180 ; END
  END d7
END r2r_dac_8bit
END LIBRARY
